#!/usr/bin/env bash
set -euo pipefail

CHEP_VERSION="0.1.1"
export CHEP_PROGRAM="$0"
CHEP_LIB_DIR="${CHEP_LIB_DIR:-/usr/lib/chep}"

usage() {
  cat <<'EOF'
Usage: chep <command> [arguments]

Package commands: update, install, remove, purge, search, show, upgrade,
                  autoremove, clean, list
Operations:       doctor [system|cpu|memory|disk|network|services|security|--collect]
Information:      version, help
EOF
}

load_module() {
  local module="$1"
  local path="$CHEP_LIB_DIR/$module"
  if [[ ! -f "$path" ]]; then
    printf 'chep: required module is missing: %s\n' "$path" >&2
    exit 3
  fi
  # Modules are shipped with Chepian and loaded only from CHEP_LIB_DIR.
  # shellcheck source=/dev/null
  source "$path"
}

command_name="${1:-help}"
if (( $# > 0 )); then
  shift
fi
command_arguments=("$@")

case "$command_name" in
  help|-h|--help)
    usage
    ;;
  version)
    printf 'Chepian Server chep %s\n' "$CHEP_VERSION"
    printf '%s\n' 'Backend: apt/dpkg'
    ;;
  update|install|remove|purge|search|show|upgrade|autoremove|clean|list)
    load_module common.sh
    load_module package.sh
    chep_package_command "$command_name" "${command_arguments[@]}"
    ;;
  doctor)
    load_module common.sh
    load_module doctor.sh
    chep_doctor "${command_arguments[@]}"
    ;;
  *)
    printf 'chep: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
